<Window x:Class="CurrencyApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="Currency App" Height="640" Width="1150"
        Language="cs-CZ"
        Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>

        <!-- Toolbar -->
        <StackPanel x:Name="ToolbarPanel" Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,10">
            <!-- Part 1 -->
            <Button x:Name="LoadXmlButton" Content="Načíst XML…" Padding="12,4" Click="LoadXmlButton_Click" />
            <Button x:Name="SaveButton" Content="Uložit den" Padding="12,4" Margin="8,0,0,0"
                    IsEnabled="False" Click="SaveButton_Click" />

            <Separator Margin="16,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />

            <!-- Part 2 -->
            <TextBlock Text="Stáhnout z ČNB:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Button x:Name="PreviousDayButton" Content="◀" Width="32" ToolTip="Předchozí pracovní den"
                    Click="PreviousDayButton_Click" />
            <DatePicker x:Name="RatesDatePicker" Width="130" Margin="4,0" VerticalContentAlignment="Center"
                        DisplayDateEnd="{x:Static sys:DateTime.Today}"
                        SelectedDateChanged="RatesDatePicker_SelectedDateChanged" />
            <Button x:Name="NextDayButton" Content="▶" Width="32" ToolTip="Další pracovní den"
                    Click="NextDayButton_Click" />
            <Button x:Name="TodayButton" Content="Dnes" Padding="12,4" Margin="8,0,0,0"
                    Click="TodayButton_Click" />
            <Button x:Name="RandomDayButton" Content="🎲 Náhodný den" Padding="12,4" Margin="8,0,0,0"
                    Click="RandomDayButton_Click" />
        </StackPanel>

        <!-- Information about the displayed list -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="#F3F6FA" CornerRadius="4" Padding="10,6" Margin="0,0,0,10">
            <StackPanel>
                <!-- Part 1 -->
                <TextBlock x:Name="DateTextBlock" FontSize="18" FontWeight="SemiBold" Text="Žádné kurzy" />
                <!-- Part 2 -->
                <TextBlock x:Name="InfoTextBlock" Foreground="Gray" />
                <TextBlock x:Name="WarningTextBlock" Foreground="DarkOrange" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <!-- Saved days -->
        <DockPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,0">
            <TextBlock DockPanel.Dock="Top" Text="Uložené dny" FontWeight="SemiBold" Margin="0,0,0,4" />
            <!-- Part 2 -->
            <Button x:Name="DeleteButton" DockPanel.Dock="Bottom" Content="Smazat vybraný den" Padding="8,4"
                    Margin="0,6,0,0" IsEnabled="False" Click="DeleteButton_Click" />
            <!-- Part 1 -->
            <ListBox x:Name="SavedDaysListBox" SelectionChanged="SavedDaysListBox_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Date, StringFormat=ddd dd.MM.yyyy}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Rates of the displayed day -->
        <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,0,10,0">
            <!-- Part 2 -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBlock Text="Hledat (kód / země):" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="FilterTextBox" Padding="2" TextChanged="FilterTextBox_TextChanged" />
            </DockPanel>
            <!-- Part 1 -->
            <DataGrid x:Name="RatesDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" AlternatingRowBackground="#F3F6FA">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Země" Binding="{Binding Country}" Width="*" />
                    <DataGridTextColumn Header="Měna" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Množství" Binding="{Binding Amount}" />
                    <DataGridTextColumn Header="Kód" Binding="{Binding Code}" />
                    <DataGridTextColumn Header="Kurz [CZK]" Binding="{Binding Rate, StringFormat=N3}" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- Part 2: currency converter -->
        <GroupBox Grid.Row="2" Grid.Column="2" Header="Převodník měn" Padding="8">
            <StackPanel>
                <TextBlock Text="Částka" />
                <TextBox x:Name="AmountTextBox" Padding="2" Margin="0,2,0,8"
                         TextChanged="AmountTextBox_TextChanged" />

                <TextBlock Text="Měna" />
                <ComboBox x:Name="CurrencyComboBox" Margin="0,2,0,8"
                          SelectionChanged="CurrencyComboBox_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding Code, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="–" />
                                <Run Text="{Binding Name, Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button x:Name="RandomConversionButton" Content="🎲 Náhodná měna a částka" Padding="8,4"
                        Click="RandomConversionButton_Click" />

                <Separator Margin="0,12" />

                <TextBlock Text="Výsledek" />
                <TextBlock x:Name="ConversionResultTextBlock" FontSize="22" FontWeight="Bold" Text="–" />
                <TextBlock x:Name="ConversionRateTextBlock" Foreground="Gray" TextWrapping="Wrap" />
            </StackPanel>
        </GroupBox>

        <!-- Status bar -->
        <DockPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,8,0,0">
            <!-- Part 2 -->
            <ProgressBar x:Name="BusyProgressBar" DockPanel.Dock="Right" Width="120" Height="12"
                         IsIndeterminate="True" Visibility="Collapsed" />
            <TextBlock x:Name="StatusTextBlock" Foreground="Gray" Text="Načtěte XML soubor s kurzy ČNB." />
        </DockPanel>
    </Grid>
</Window>
